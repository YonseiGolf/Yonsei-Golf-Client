{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["DOM", "DOM.Iterable", "ES2025"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "tests", "e2e", "*.config.ts"],
	"exclude": ["node_modules", "dist"]
}
